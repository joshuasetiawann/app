{
  "name": "kisahkita",
  "private": true,
  "version": "1.0.0",
  "description": "A private, real-time digital space for long-distance couples.",
  "author": {
    "name": "Joshua Setiawan",
    "email": "07joshua2020@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshuasetiawann/app.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "mobile:sync": "npm run build && cap sync && node scripts/fix-ios-package-paths.mjs",
    "android:open": "cap open android",
    "android:run": "npm run mobile:sync && cap run android",
    "android:apk": "npm run mobile:sync && node scripts/build-android.mjs",
    "ios:open": "cap open ios",
    "ios:sync": "npm run build && cap sync ios && node scripts/fix-ios-package-paths.mjs",
    "ios:configure-google": "node scripts/configure-ios-google.mjs",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:drive": "node scripts/google-drive-qa.mjs",
    "qa:production": "node scripts/supabase-production-qa.mjs",
    "qa:mobile-features": "node scripts/mobile-features-qa.mjs",
    "reset:cloud": "node scripts/reset-supabase.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-social-login": "^8.4.5",
    "@supabase/supabase-js": "^2.112.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
