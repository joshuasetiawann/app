# Phase 1 (current): the app runs entirely on in-memory mock data — no
# environment variables are required to develop or build it.
#
# Phase 2+: once Supabase is provisioned (see README.md → "Supabase
# migration plan" and supabase/schema.sql), copy this file to .env.local
# and fill in the values from your Supabase project settings → API.
# Never commit the real .env.local file or a service-role key to the repo.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
