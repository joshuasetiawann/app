# Supabase is optional. Without these values, KisahKita automatically uses
# its local browser mode for development and same-device testing.
# To enable shared authentication, pairing, and location ping across devices,
# copy this file to .env.local and fill in your Supabase project settings.
# Never commit the real .env.local file or any secret/service-role key.
#
# New projects should use the publishable browser key. During migration, the
# client may fall back to VITE_SUPABASE_ANON_KEY when the publishable variable
# is empty; the legacy anon key is intentionally documented only as fallback.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback: VITE_SUPABASE_PUBLISHABLE_KEY || VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_ANON_KEY=

# Google identity for the optional Google Drive integration only.
# Use an OAuth 2.0 Web Client ID, never a client secret or service-account key.
VITE_GOOGLE_DRIVE_CLIENT_ID=
# Required only for the native iOS build. Create an OAuth 2.0 iOS Client ID
# whose bundle ID is com.joshuasetiawan.kisahkita.
VITE_GOOGLE_DRIVE_IOS_CLIENT_ID=
